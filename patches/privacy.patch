diff --git a/launcher/src/offline_java.rs b/launcher/src/offline_java.rs
new file mode 100644
index 0000000..9040f72
--- /dev/null
+++ b/launcher/src/offline_java.rs
@@ -0,0 +1,177 @@
+//! Offline Java launch using already installed, hash-checked Minecraft files.
+use crate::{mojang, sources};
+use serde_json::Value;
+use std::{
+    collections::HashMap,
+    fs,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+};
+
+pub(crate) fn player(name: &str) -> Result<crate::java_launch::Player, String> {
+    if !crate::account::valid_offline_name(name) {
+        return Err("Choose an offline name of 3 to 16 letters, digits or underscores".into());
+    }
+    Ok(crate::java_launch::Player {
+        name: name.to_string(),
+        uuid: format!("{:032x}", horizon_protocol::crypto::offline_uuid(name)),
+        token: "0".into(),
+        xuid: String::new(),
+    })
+}
+
+fn add(map: &mut HashMap<String, Vec<(PathBuf, String)>>, url: &str, path: PathBuf, hash: &str) {
+    map.entry(url.to_string())
+        .or_default()
+        .push((path, hash.to_string()));
+}
+
+/// Copy only files named by Mojang's verified manifest, never modify another launcher.
+pub(crate) fn import(
+    id: &str,
+    sha1: &str,
+    dest: &Path,
+    folders: &[PathBuf],
+    fetch_metadata: sources::Fetch,
+    log: &dyn Fn(String),
+) -> Result<(), String> {
+    let mut pins = sources::Pins::for_version(id, sha1);
+    let id_path = mojang::relative(id)?;
+    let manifest_file = dest
+        .join("versions")
+        .join(&id_path)
+        .join(format!("{id}.json"));
+    sources::fetch_manifest(&pins, &manifest_file, fetch_metadata, log)?;
+    let manifest: Value =
+        serde_json::from_slice(&fs::read(&manifest_file).map_err(|e| e.to_string())?)
+            .map_err(|e| format!("Invalid version file: {e}"))?;
+    let client = &manifest["downloads"]["client"];
+    pins.client_sha1 = client["sha1"]
+        .as_str()
+        .ok_or("Missing client hash")?
+        .to_owned();
+    let client_url = client["url"].as_str().ok_or("Missing client URL")?;
+    let found: Vec<_> = folders
+        .iter()
+        .filter_map(|f| sources::find(f, &pins).ok())
+        .collect();
+    if found.is_empty() {
+        return Err(format!("Minecraft {id} was not found locally. Install this version in ElyPrism or another launcher first."));
+    }
+    let mut map: HashMap<String, Vec<(PathBuf, String)>> = HashMap::new();
+    for source in &found {
+        add(
+            &mut map,
+            client_url,
+            source.client.clone(),
+            &pins.client_sha1,
+        );
+        let base = &source.base;
+        if let Some(libs) = manifest["libraries"].as_array() {
+            for lib in libs {
+                let downloads = &lib["downloads"];
+                let artifacts = downloads["artifact"]
+                    .as_object()
+                    .into_iter()
+                    .map(|_| &downloads["artifact"])
+                    .chain(
+                        downloads["classifiers"]
+                            .as_object()
+                            .into_iter()
+                            .flat_map(|v| v.values()),
+                    );
+                for a in artifacts {
+                    if let (Some(url), Some(path), Some(hash)) =
+                        (a["url"].as_str(), a["path"].as_str(), a["sha1"].as_str())
+                    {
+                        add(
+                            &mut map,
+                            url,
+                            base.join("libraries").join(mojang::relative(path)?),
+                            hash,
+                        );
+                    }
+                }
+            }
+        }
+        let config = &manifest["logging"]["client"]["file"];
+        if let (Some(url), Some(id), Some(hash)) = (
+            config["url"].as_str(),
+            config["id"].as_str(),
+            config["sha1"].as_str(),
+        ) {
+            add(
+                &mut map,
+                url,
+                base.join("assets/log_configs").join(mojang::relative(id)?),
+                hash,
+            );
+        }
+        let index = &manifest["assetIndex"];
+        if let (Some(url), Some(index_id), Some(hash)) = (
+            index["url"].as_str(),
+            index["id"].as_str(),
+            index["sha1"].as_str(),
+        ) {
+            let file = format!("{index_id}.json");
+            add(
+                &mut map,
+                url,
+                base.join("assets/indexes").join(mojang::relative(&file)?),
+                hash,
+            );
+        }
+    }
+    let missing = AtomicBool::new(false);
+    let local = |url: &str| -> Result<Vec<u8>, String> {
+        if let Some(paths) = map.get(url) {
+            for (path, hash) in paths {
+                if let Ok(data) = fs::read(path) {
+                    if sources::sha1_hex(&data) == *hash {
+                        return Ok(data);
+                    }
+                }
+            }
+        }
+        if let Some(rel) = url.strip_prefix("https://resources.download.minecraft.net/") {
+            let parts: Vec<_> = rel.split('/').collect();
+            if parts.len() == 2
+                && parts[1].len() == 40
+                && parts[1].bytes().all(|b| b.is_ascii_hexdigit())
+                && parts[0] == &parts[1][..2]
+            {
+                for source in &found {
+                    let path = source
+                        .base
+                        .join("assets/objects")
+                        .join(parts[0])
+                        .join(parts[1]);
+                    if let Ok(data) = fs::read(path) {
+                        if sources::sha1_hex(&data) == parts[1] {
+                            return Ok(data);
+                        }
+                    }
+                }
+            }
+        }
+        missing.store(true, Ordering::Relaxed);
+        Err("Required file is not available in the existing installation".into())
+    };
+    let os = match sources::Os::current() {
+        sources::Os::Linux => "linux",
+        sources::Os::MacOs => "osx",
+        sources::Os::Windows => "windows",
+    };
+    log(format!(
+        "Copying existing Minecraft {id} files into Horizon's private cache"
+    ));
+    mojang::download(&pins, dest, os, 8, &local, &mojang::CANCEL, log)?;
+    if missing.load(Ordering::Relaxed) {
+        return Err(format!("Minecraft {id} is incomplete in the existing installation. Start this version in ElyPrism or another launcher, then retry."));
+    }
+    Ok(())
+}

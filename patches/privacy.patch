+
+#[test]
+fn elyprism_windows_instances_are_discovered() {
+    let root = scratch("elyprism-windows");
+    let instance = root.join("ElyPrismLauncher/instances/example");
+    write(&instance.join("instance.cfg"), "[General]\nname=Example\n");
+    write(
+        &instance.join("mmc-pack.json"),
+        &json!({"components": [{"uid": "net.minecraft", "version": "26.3"}]}).to_string(),
+    );
+    fs::create_dir_all(instance.join("minecraft")).unwrap();
+    let folders = Folders {
+        home: root.clone(),
+        data: root.clone(),
+        config: root.clone(),
+    };
+    let found = scan(Os::Windows, &folders);
+    assert!(found
+        .iter()
+        .any(|i| i.launcher == "ElyPrism" && i.name == "Example"));
+    assert_eq!(in_folder(&instance, None)[0].launcher, "ElyPrism");
+    let _ = fs::remove_dir_all(root);
+}

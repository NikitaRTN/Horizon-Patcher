--- /dev/null
+++ b/launcher/src/smart_updates.rs
@@ -0,0 +1,82 @@
+//! Patcher compatibility is based on published, CI-tested patcher releases, not guesses.
+use serde_json::Value;
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct Version(u64, u64, u64);
+fn version(s: &str) -> Option<Version> {
+    let mut parts = s.split('.');
+    let parse = |p: &str| {
+        if p.is_empty() || !p.bytes().all(|b| b.is_ascii_digit()) { return None; }
+        p.parse().ok()
+    };
+    let v = Version(parse(parts.next()?)?, parse(parts.next()?)?, parse(parts.next()?)?);
+    if parts.next().is_some() { None } else { Some(v) }
+}
+fn has_asset(release: &Value, name: &str) -> bool {
+    release["assets"].as_array().is_some_and(|a| a.iter().any(|a| a["name"].as_str() == Some(name)))
+}
+fn stable(release: &Value) -> bool {
+    release["draft"].as_bool() == Some(false) && release["prerelease"].as_bool() == Some(false)
+}
+fn supported_release(release: &Value) -> Option<String> {
+    if !stable(release) || !has_asset(release, "HorizonPatcher.exe") { return None; }
+    let tag = release["tag_name"].as_str()?.strip_prefix("patcher-")?;
+    let (v, commit) = tag.split_once('-')?;
+    if commit.len() < 7 || !commit.bytes().all(|b| b.is_ascii_hexdigit()) { return None; }
+    version(v)?;
+    Some(v.to_owned())
+}
+fn official_release(list: &Value) -> Option<String> {
+    list.as_array()?.iter().filter(|r| stable(r) && has_asset(r, "horizon-launcher-windows-x64.zip"))
+        .filter_map(|r| { let v = r["tag_name"].as_str()?.strip_prefix("launcher@")?; Some((version(v)?, v.to_owned())) })
+        .max_by(|a,b| a.0.cmp(&b.0)).map(|(_,v)| v)
+}
+#[derive(Clone, Debug, Default)]
+pub struct Compatibility {
+    pub supported: Option<String>,
+    pub latest: Option<String>,
+}
+impl Compatibility {
+    pub fn check() -> Self {
+        // Independent failures leave the corresponding state unknown, not unsupported.
+        let supported = crate::github::json("https://api.github.com/repos/NikitaRTN/Horizon-Patcher/releases/latest")
+            .ok().and_then(|v| supported_release(&v));
+        let latest = crate::github::json("https://api.github.com/repos/horizon-rust/horizon/releases?per_page=100")
+            .ok().and_then(|v| official_release(&v));
+        Self { supported, latest }
+    }
+    pub fn update_available(&self, current: &str) -> bool {
+        self.supported.as_deref().and_then(version).zip(version(current)).is_some_and(|(a,b)| a > b)
+    }
+    pub fn latest_unverified(&self) -> bool {
+        self.latest.as_deref().and_then(version).zip(self.supported.as_deref().and_then(version)).is_some_and(|(a,b)| a > b)
+    }
+    pub fn zip(v: &str) -> Option<String> {
+        version(v)?;
+        Some(format!("https://github.com/horizon-rust/horizon/releases/download/launcher%40{v}/horizon-launcher-windows-x64.zip"))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn patcher_compatibility_release_parsing() {
+        let r = json!({"tag_name":"patcher-0.2.44-3796e84a","draft":false,"prerelease":false,"assets":[{"name":"HorizonPatcher.exe"}]});
+        assert_eq!(supported_release(&r).as_deref(), Some("0.2.44"));
+        let mut bad=r.clone(); bad["draft"]=json!(true); assert_eq!(supported_release(&bad), None);
+        let mut bad=r.clone(); bad["assets"]=json!([]); assert_eq!(supported_release(&bad), None);
+        let mut bad=r; bad["tag_name"]=json!("patcher-0.2.44-evil/path"); assert_eq!(supported_release(&bad), None);
+    }
+    #[test]
+    fn patcher_compatibility_never_guesses() {
+        let a=Compatibility { supported:Some("0.2.9".into()),latest:Some("0.2.10".into()) };
+        assert!(a.latest_unverified()); assert!(a.update_available("0.2.8"));
+        assert!(!Compatibility { supported:None, latest:a.latest.clone() }.latest_unverified());
+        assert!(!Compatibility { supported:Some("0.2.10".into()), latest:Some("0.2.10".into()) }.latest_unverified());
+        assert!(!a.update_available("not-a-version"));
+        assert!(Compatibility::zip("1/../../x").is_none());
+        let list=json!([{ "tag_name":"launcher@0.2.9", "draft":false,"prerelease":false,"assets":[{"name":"horizon-launcher-windows-x64.zip"}] }, { "tag_name":"launcher@0.2.10", "draft":false,"prerelease":false,"assets":[{"name":"horizon-launcher-windows-x64.zip"}] }, {"tag_name":"launcher@9.0.0", "draft":false,"prerelease":true,"assets":[{"name":"horizon-launcher-windows-x64.zip"}]}]);
+        assert_eq!(official_release(&list).as_deref(),Some("0.2.10"));
+    }
+}

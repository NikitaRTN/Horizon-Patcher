+#[test]
+fn offline_java_uses_legacy_user_type() {
+    let dir = scratch("offline-user-type");
+    let p = crate::offline_java::player("Notch").unwrap();
+    let launch = Launch {
+        minecraft: &dir.join("mc"),
+        game_dir: &dir.join("game"),
+        natives: &dir.join("natives"),
+        java: &dir.join("java"),
+        memory_mb: 1024,
+        jvm_args: &[],
+        player: &p,
+        os: "windows",
+        window: None,
+        server: None,
+    };
+    let command = command(&modern(), &launch).unwrap();
+    let a = args(&command);
+    let i = a.iter().position(|arg| arg == "--userType").unwrap();
+    assert_eq!(a[i + 1], "legacy");
+    let i = a.iter().position(|arg| arg == "--accessToken").unwrap();
+    assert_eq!(a[i + 1], "0");
+}

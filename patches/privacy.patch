+#[test]
+fn offline_player_has_stable_vanilla_identity() {
+    let p = player("Notch").unwrap();
+    assert_eq!(p.uuid, "b50ad385829d3141a2167e7d7539ba7f");
+    assert_eq!(p.token, "0");
+    assert!(p.xuid.is_empty());
+    assert!(player("bad name!").is_err());
+}
+
+fn put(path: &Path, bytes: &[u8]) {
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, bytes).unwrap();
+}
+
+#[test]
+fn offline_import_copies_only_verified_existing_files() {
+    let nonce = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let tmp = std::env::temp_dir().join(format!(
+        "horizon-offline-test-{}-{nonce}",
+        std::process::id()
+    ));
+    let source = tmp.join("ElyPrismLauncher");
+    let dest = tmp.join("horizon");
+    let client = b"client";
+    let library = b"library";
+    let asset = b"sound";
+    let hash = sources::sha1_hex(asset);
+    let index = json!({"objects":{"sounds/example":{"hash":hash,"size":asset.len()}}}).to_string();
+    let manifest = json!({"id":"1.21.1",
+        "downloads":{"client":{"url":"local:client","sha1":sources::sha1_hex(client),"size":client.len()}},
+        "libraries":[{"downloads":{"artifact":{"url":"local:lib","path":"a/b.jar","sha1":sources::sha1_hex(library),"size":library.len()}}}],
+        "assetIndex":{"id":"test","url":"local:index","sha1":sources::sha1_hex(index.as_bytes()),"size":index.len()}
+    }).to_string();
+    let sha = sources::sha1_hex(manifest.as_bytes());
+    let jar = source.join("libraries/com/mojang/minecraft/1.21.1/minecraft-1.21.1-client.jar");
+    let lib = source.join("libraries/a/b.jar");
+    let asset_path = source.join("assets/objects").join(&hash[..2]).join(&hash);
+    put(&jar, client);
+    put(&lib, library);
+    put(&source.join("assets/indexes/test.json"), index.as_bytes());
+    put(&asset_path, asset);
+    let fetch = |url: &str| {
+        if url.starts_with("https://piston-meta.mojang.com/") {
+            Ok(manifest.as_bytes().to_vec())
+        } else {
+            Err(format!("Unexpected network request: {url}"))
+        }
+    };
+    import("1.21.1", &sha, &dest, &[source.clone()], &fetch, &|_| {}).unwrap();
+    assert_eq!(
+        fs::read(dest.join("versions/1.21.1/1.21.1.jar")).unwrap(),
+        client
+    );
+    assert_eq!(fs::read(dest.join("libraries/a/b.jar")).unwrap(), library);
+    assert_eq!(
+        fs::read(dest.join("assets/objects").join(&hash[..2]).join(&hash)).unwrap(),
+        asset
+    );
+    assert_eq!(fs::read(&jar).unwrap(), client);
+    assert_eq!(fs::read(&lib).unwrap(), library);
+    fs::write(&asset_path, b"corrupt").unwrap();
+    assert!(import("1.21.1", &sha, &tmp.join("bad"), &[source], &fetch, &|_| {}).is_err());
+    fs::remove_dir_all(tmp).unwrap();
+}
